#include <windows.h>
#include "version.h"
2 ICON "app.ico"
10 RCDATA "logo.png"
3 RCDATA "../third_party/stb/LICENSE"
4 RCDATA "../third_party/nanosvg/LICENSE.txt"
6 RCDATA "../third_party/libwebp/COPYING"
7 RCDATA "../third_party/libwebp/PATENTS"
5 RCDATA "../LICENSE"
1 RT_MANIFEST FOTO_MANIFEST_FILE
1 VERSIONINFO
 FILEVERSION FOTO_VERSION_RESOURCE
 PRODUCTVERSION FOTO_VERSION_RESOURCE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "Lyvt-Dev\0"
   VALUE "FileDescription", "PAF-Photos - Native photo viewer\0"
   VALUE "FileVersion", FOTO_VERSION_STRING "\0"
   VALUE "ProductName", "PAF-Photos\0"
   VALUE "ProductVersion", FOTO_VERSION_STRING "\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END

200 DIALOGEX 0, 0, 310, 202
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Resize image"
FONT 10, "Segoe UI"
BEGIN
 LTEXT "", 101, 16, 12, 278, 16
 LTEXT "Width (pixels)", 102, 16, 40, 130, 14
 LTEXT "Height (pixels)", 103, 162, 40, 130, 14
 EDITTEXT 104, 16, 58, 130, 24, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
 EDITTEXT 105, 162, 58, 130, 24, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
 CONTROL "Keep aspect ratio", 106, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 92, 276, 18
 LTEXT "", 107, 16, 117, 278, 18
 LTEXT "", 108, 16, 140, 278, 26
 CONTROL "Apply", IDOK, "Button", BS_OWNERDRAW | WS_TABSTOP, 130, 175, 78, 24
 CONTROL "Cancel", IDCANCEL, "Button", BS_OWNERDRAW | WS_TABSTOP, 216, 175, 78, 24
END
